# Files that belong in the repository but not in the distributed plugin ZIP.
#
# `git archive` includes every tracked file by default, so a new file ships
# automatically and only the entries listed here are held back. This is
# deliberately the opposite of enumerating what to include — that is how
# pix/ was left out of the 1.0.1 package.
/.github        export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
